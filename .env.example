# Voxel Trading — copy to .env and fill in.
# Secrets stay on the server. The app runs without paid keys using Yahoo as fallback.

ENVIRONMENT=development
ALGORITHM_VERSION=1.0.0
BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
HTTP_TIMEOUT=20

# Same-origin API. Leave empty so the browser calls /api/... on this Next.js app.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_BRAND_SITE_URL=https://voxel-ai-lab.com

# Local JSON store (watchlist, alerts, signal snapshots).
DATABASE_URL=file:./data/protrader.json

# Optional market-data keys. Yahoo is always the last fallback.
TWELVE_DATA_API_KEY=
ALPHA_VANTAGE_API_KEY=
FINNHUB_API_KEY=
FRED_API_KEY=
OPENAI_API_KEY=
# Optional live economic calendar URL used by Market Events This Week (server-side only).
ECONOMIC_CALENDAR_URL=https://nfs.faireconomy.media/ff_calendar_thisweek.json

PRIMARY_PROVIDER=twelve_data
FALLBACK_PROVIDERS=alpha_vantage,finnhub,yfinance
MIN_RISK_REWARD=1.5
EARNINGS_DANGER_DAYS=2
STALE_QUOTE_SECONDS=120

MOVERS_MIN_SIGNIFICANT_MOVE=50
MOVERS_MIN_GAINER_PERCENT=0
MOVERS_MIN_LOSER_PERCENT=0
MOVERS_MIN_PRICE=1
MOVERS_MIN_VOLUME=100000
MOVERS_EXCLUDE_ETF=true
MOVERS_EXCLUDE_OTC=true
MOVERS_EXCHANGES=NYSE,NASDAQ,AMEX,ARCA,BATS,NMS,NYQ

# Browser-safe Supabase values only. Never put service-role keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Instagram is not a native Supabase provider; default is custom:instagram
# after you add a Custom OAuth provider in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_INSTAGRAM_PROVIDER=custom:instagram
